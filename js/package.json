{
  "name": "django-byo-react",
  "version": "1.0.0",
  "description": "Type-safe parser and React mount helpers for the django-byo-react template tag.",
  "license": "MIT",
  "author": "lukewiwa <luke.wiwa@gmail.com>",
  "homepage": "https://github.com/lukewiwa/django-byo-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukewiwa/django-byo-react.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/lukewiwa/django-byo-react/issues"
  },
  "keywords": [
    "django",
    "react",
    "json-script",
    "template-tag",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
